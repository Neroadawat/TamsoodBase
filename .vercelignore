# Allow only the static frontend builder, its assets, required API routes, and
# the two reviewed JSON files included in the Gemini Preview Function.
/*
!vercel.json
!api
api/*
!api/[[]route].js
!api/rag
api/rag/*
!api/rag/ask.js
!scripts
scripts/*
!scripts/build_frontend.mjs
!web
web/*
!web/index.html
!web/style.css
!web/app.js
!web/api.js
!web/config.js
!web/favicon.svg
!web/upstream-inventory.json
!web/case-study.js
!web/case-study.json
!web/discovery.js
!web/story.js
!web/theme.css
!web/design-refresh.css
!web/ask.html
!web/noto-sans-thai-06310198b08f.woff2
!web/FONT-LICENSE.txt
!docs
docs/*
!docs/rag
docs/rag/*
!docs/rag/public-release-manifest.json
!docs/rag/vercel-preview-corpus.json
